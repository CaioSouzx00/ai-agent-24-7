    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Request Throughput by Channel (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (channel) (rate(agent_requests_total[1m]))",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Tool Executions by Tool & Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool_name, status) (rate(agent_tool_calls_total[1m]))",
          "legendFormat": "{{tool_name}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 7,
      "title": "Response Latency Percentiles (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Median Latency",
          "refId": "B"
        }
      ]
    }
