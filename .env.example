# ==============================================================================
# AI Agent 24/7 - Environment Configuration Reference (.env)
# ==============================================================================

# --- Application Runtime Environment ---
APP_ENV=dev                                       # Target environment: dev, test, or prod
PUBLIC_URL=http://localhost:8080                  # Public URL of the agent instance

# --- LLM Provider & Inference (NVIDIA NIM or OpenAI) ---
LLM_PROVIDER=nim                                  # Inference engine: nim or openai
NIM_BASE_URL=http://localhost:8000/v1             # OpenAI-compatible API base URL
NIM_MODEL=meta/llama-3.1-8b-instruct              # Model identifier for reasoning graph
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5           # Model for vector embeddings (pgvector)
NIM_API_KEY=not-needed-locally                    # Cloud API Key (required if hosted)

# --- Persistence & Memory Tier ---
REDIS_URL=redis://localhost:6379/0                # Redis connection URI for sessions & rate limits
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent # PostgreSQL URI with pgvector extension

# --- Authentication & Access Control ---
API_KEYS=dev-key-1,dev-key-2                      # Comma-separated client API keys
JWT_SECRET=                                       # Shared HMAC-SHA256 secret for JWT tokens
JWT_JWKS_URL=                                     # Remote JWKS URL for asymmetric validation (Clerk/Auth0)
JWT_AUDIENCE=                                     # Expected JWT audience claim (aud)
JWT_ISSUER=                                       # Expected JWT issuer claim (iss)

# --- Rate Limiting (Sliding Window) ---
RATE_LIMIT_ENABLED=true                           # Enables sliding window rate limiting
RATE_LIMIT_PER_MINUTE=60                          # Maximum requests per minute per IP/key

# --- Messaging Channels & Webhooks ---
SLACK_BOT_TOKEN=                                  # Slack Bot Token (xoxb-...)
SLACK_SIGNING_SECRET=                             # Slack HMAC signature verification secret
SLACK_HANDOFF_WEBHOOK=                            # Slack Incoming Webhook for human escalation
WHATSAPP_TOKEN=                                   # Meta Graph API Bearer token
WHATSAPP_VERIFY_TOKEN=                            # Webhook verification handshake token
WHATSAPP_APP_SECRET=                              # Meta App Secret for HMAC payload verification
GMAIL_PUBSUB_VERIFICATION_TOKEN=                  # Token for Google Cloud Pub/Sub push webhook

# --- External Tool Integrations ---
GITHUB_TOKEN=                                     # GitHub Personal Access Token
GOOGLE_ACCESS_TOKEN=                              # Google OAuth Access Token (Gmail/Calendar)
GOOGLE_SERVICE_ACCOUNT_FILE=                      # Path to Google Service Account JSON file
GOOGLE_OAUTH_CREDENTIALS_FILE=                    # Path to Google OAuth Client Credentials JSON file
VISION_MODEL=                                     # Multimodal vision model (e.g. meta/llama-3.2-11b-vision-instruct)

# --- Voice Processing Pipeline (STT & TTS) ---
STT_MODEL=whisper-1                               # Speech-to-Text transcription model
TTS_MODEL=tts-1                                   # Text-to-Speech synthesis model
TTS_VOICE=alloy                                   # Voice profile: alloy, echo, fable, onyx, nova, shimmer

# --- Background Orchestration & Monitoring ---
TEMPORAL_ADDRESS=localhost:7233                   # Temporal server host address for durable workflows
SENTRY_DSN=                                       # Sentry DSN for centralized exception tracking
