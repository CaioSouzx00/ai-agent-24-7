              "raw": "{\n  \"type\": \"event_callback\",\n  \"event\": {\n    \"type\": \"message\",\n    \"channel\": \"C12345678\",\n    \"text\": \"Hello AI Agent\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/slack",
