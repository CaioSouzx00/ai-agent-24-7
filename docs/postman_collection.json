            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entry\": [\n    {\n      \"changes\": [\n        {\n          \"value\": {\n            \"metadata\": {\"phone_number_id\": \"10987654321\"},\n            \"messages\": [\n              {\n                \"from\": \"+15551234567\",\n                \"text\": {\"body\": \"Need help with my account\"}\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
